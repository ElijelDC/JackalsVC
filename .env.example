# Database — local dev (Fly production uses file:/data/jackals.db on the volume)
DATABASE_URL="file:./prisma/dev.db"

# Auth — generate with: openssl rand -base64 32
# dev:setup fills this automatically when creating .env
AUTH_SECRET=""

# Public site URL (emails, calendar links, coach reminders)
# Local dev: npm run dev serves on port 3005
NEXT_PUBLIC_SITE_URL="http://localhost:3005"

# NextAuth canonical URL — must match npm run dev locally (port 3005)
AUTH_URL="http://localhost:3005"

# Club bank details (member payment instructions)
CLUB_IBAN=""
CLUB_ACCOUNT_HOLDER="Jackals VC"

# SumUp API (optional — payment reconciliation)
SUMUP_API_KEY=""
SUMUP_MERCHANT_CODE=""

# Payment sync webhook (optional in dev; required in production for POST /api/payments/sync)
PAYMENTS_SYNC_SECRET=""
PAYMENT_EMAIL_WEBHOOK_SECRET=""
# Required in production — only these sender domains can trigger payment email reconciliation
PAYMENT_EMAIL_ALLOWED_SENDERS="sumup.com"

# Email — required in production for registration verification and notifications
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Admin notification recipients (comma-separated). If unset, all ADMIN users are emailed.
ADMIN_NOTIFICATION_EMAILS=""

# Secret for cron endpoints (required in production): POST /api/cron/membership-due, /api/cron/reclub-sync
CRON_SECRET=""

# Reclub → website sync (optional)
# Webhook secret for POST /api/webhooks/reclub
RECLUB_WEBHOOK_SECRET=""
# Comma-separated meet codes for /api/cron/reclub-sync to refresh (e.g. ABC123,DEF456)
RECLUB_SYNC_REFERENCE_CODES=""
# Club slug on Reclub (default: jackals-volleyball). Used to pull upcoming activities.
RECLUB_CLUB_SLUG="jackals-volleyball"
# Optional: Reclub group id (9245 for Jackals VC). Skips club payload lookup when set.
RECLUB_GROUP_ID=""

# Instagram homepage feed (optional)
INSTAGRAM_USER_ID=""
INSTAGRAM_ACCESS_TOKEN=""
