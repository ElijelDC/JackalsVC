# Database — local dev (Fly production uses file:/data/jackals.db on the volume)
DATABASE_URL="file:./prisma/dev.db"

# Auth — generate with: openssl rand -base64 32
AUTH_SECRET=""

# Public site URL (emails, calendar links, coach reminders)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Club bank details (member payment instructions)
CLUB_IBAN=""
CLUB_ACCOUNT_HOLDER="Jackals VC"

# SumUp API (optional — payment reconciliation)
SUMUP_API_KEY=""
SUMUP_MERCHANT_CODE=""

# Payment sync webhook (optional)
PAYMENTS_SYNC_SECRET=""
PAYMENT_EMAIL_WEBHOOK_SECRET=""
PAYMENT_EMAIL_ALLOWED_SENDERS="sumup.com"

# Email — required in production for registration verification
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Instagram homepage feed (optional)
INSTAGRAM_USER_ID=""
INSTAGRAM_ACCESS_TOKEN=""
