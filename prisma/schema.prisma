generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                 String            @id @default(cuid())
  name               String
  email              String            @unique
  passwordHash       String
  role               String            @default("MEMBER")
  registrationCodeId String?
  registrationCode   RegistrationCode? @relation(fields: [registrationCodeId], references: [id])
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  memberships        Membership[]
  orders             Order[]
  payments           Payment[]
  eventReminders     EventReminder[]
  eventSignups       EventSignup[]
  matchSignups       MatchSignup[]
  clubMember         ClubMember?
  coachResponseReminders CoachResponseReminder[]
  eventNewsletterSubscription EventNewsletterSubscription?
}

model EventNewsletterSubscription {
  id        String   @id @default(cuid())
  email     String   @unique
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  active    Boolean  @default(true)
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model ClubMember {
  id              String           @id @default(cuid())
  vlyNumber       String           @unique
  name            String
  active          Boolean          @default(true)
  rosterRole      String           @default("PLAYER")
  coachPaymentType String?
  trainingTeamKey String?
  profileImageUrl        String?
  vlyMembershipPhotoUrl  String?
  playerNumber           Int?
  registrationContactEmail       String?
  registrationReviewStatus       String?
  registrationPhotoSubmittedAt   DateTime?
  registrationReviewedAt         DateTime?
  registrationReviewedByUserId   String?
  userId                 String?          @unique
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  clubTeamMembers ClubTeamMember[]
  coachSquads     ClubMemberCoachSquad[]
  coachPayments   CoachSalaryPayment[]
}

model ClubMemberCoachSquad {
  id              String     @id @default(cuid())
  clubMemberId    String
  clubMember      ClubMember @relation(fields: [clubMemberId], references: [id], onDelete: Cascade)
  trainingTeamKey String
  createdAt       DateTime   @default(now())

  @@unique([clubMemberId, trainingTeamKey])
  @@index([trainingTeamKey])
}

model CoachSalaryPayment {
  id                   String     @id @default(cuid())
  clubMemberId         String
  clubMember           ClubMember @relation(fields: [clubMemberId], references: [id], onDelete: Cascade)
  year                 Int
  month                Int
  sessionCount         Int
  ratePerSession       Float      @default(25)
  amount               Float
  status               String     @default("PENDING")
  invoiceScreenshotUrl String?
  paidAt               DateTime?
  notes                String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@unique([clubMemberId, year, month])
  @@index([year, month])
}

model EmailVerification {
  id         String    @id @default(cuid())
  email      String
  vlyNumber  String
  codeHash   String
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, vlyNumber])
}

model RegistrationCode {
  id        String    @id @default(cuid())
  code      String    @unique
  label     String?
  maxUses   Int?
  usedCount Int       @default(0)
  active    Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  users     User[]
}

model TrainingSquad {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  dayOfWeek Int
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TrainingSession {
  id              String   @id @default(cuid())
  category        String   @default("WEEKLY")
  trainingTeamKey String?  @unique
  title           String
  dayOfWeek       Int
  startTime     String
  endTime       String
  location      String
  level         String
  description   String?
  coach         String?
  attendanceUrl String?
  paymentUrl      String?
  reclubUsername  String?
  sessionFee      Float?
  recurring       Boolean  @default(true)
  recurrenceWeeks Int      @default(1)
  recurringFrom   DateTime?
  recurringTo     DateTime?
  sessionDate     DateTime?
  createdAt     DateTime @default(now())
  events        Event[]
  occurrenceExceptions TrainingOccurrenceException[]
}

model TrainingOccurrenceException {
  id                String          @id @default(cuid())
  trainingSessionId String
  trainingSession   TrainingSession @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  occurrenceDate    DateTime
  cancelled         Boolean         @default(false)
  title             String?
  description       String?
  startDate         DateTime?
  endDate           DateTime?
  location          String?
  coach             String?
  attendanceUrl     String?
  paymentUrl        String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([trainingSessionId, occurrenceDate])
}

model Event {
  id                     String           @id @default(cuid())
  title                  String
  description            String?
  startDate              DateTime
  endDate                DateTime?
  type                   String
  location               String?
  attendanceUrl          String?
  paymentUrl             String?
  sessionFee             Float?
  reclubUsername         String?
  reclubReferenceCode    String?          @unique
  clubIban               String?
  rulesPdfUrl            String?
  trainingSessionId      String?
  trainingSession        TrainingSession? @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  trainingOccurrenceDate DateTime?
  createdAt              DateTime         @default(now())
  reminders              EventReminder[]
  signups                EventSignup[]
}

model EventSignup {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  status    String   @default("ATTENDING")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, eventId])
}

model EventReminder {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, eventId])
}

model TeamMatch {
  id              String        @id @default(cuid())
  trainingTeamKey String
  opponentName    String
  venue           String
  location        String
  warmUpTime      DateTime
  matchStart      DateTime
  notes           String?
  cancelled       Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  signups         MatchSignup[]

  @@index([trainingTeamKey, matchStart])
}

model MatchSignup {
  id        String    @id @default(cuid())
  userId    String
  matchId   String
  status    String    @default("ATTENDING")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  match     TeamMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([userId, matchId])
}

model CoachResponseReminder {
  id          String   @id @default(cuid())
  coachUserId String
  coach       User     @relation(fields: [coachUserId], references: [id], onDelete: Cascade)
  targetKind  String
  targetId    String
  lastSentAt  DateTime @default(now())

  @@unique([coachUserId, targetKind, targetId])
}

model MembershipPlan {
  id             String       @id @default(cuid())
  name           String
  description    String
  price          Float
  durationMonths Int
  features       String
  active         Boolean      @default(true)
  memberships    Membership[]
}

model Membership {
  id                        String         @id @default(cuid())
  userId                    String
  planId                    String
  paymentSchedule           String         @default("FULL")
  status                    String         @default("ACTIVE")
  paymentOverdueOverride      Boolean        @default(false)
  paymentOverdueOverrideNote  String?
  paymentOverdueOverrideUntil DateTime?
  paymentDeferralExcuse       String?
  paymentDeferralDueDate      DateTime?
  paymentDeferralRequestedAt  DateTime?
  startDate                 DateTime       @default(now())
  endDate                   DateTime
  user                      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                      MembershipPlan @relation(fields: [planId], references: [id])
  payments                  Payment[]
  createdAt                 DateTime       @default(now())
}

model Payment {
  id                   String      @id @default(cuid())
  userId               String
  membershipId         String?
  amount               Float
  description          String
  status               String      @default("PENDING")
  method               String      @default("BANK_TRANSFER")
  paymentReference     String
  installmentNumber    Int?
  dueDate              DateTime?
  paidAt               DateTime?
  sumupTransactionId   String?
  sumupTransactionCode String?
  sumupMatchedAt       DateTime?
  proofScreenshotUrl   String?
  proofSubmittedAt     DateTime?
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership           Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  emailMatches         ProcessedPaymentEmail[]
  dueReminders         MembershipDueReminder[]
  createdAt            DateTime    @default(now())

  @@unique([userId, paymentReference])
  @@index([status, dueDate])
  @@index([sumupTransactionId])
}

model MembershipDueReminder {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  kind      String
  sentAt    DateTime @default(now())

  @@unique([paymentId, kind])
}

model ProcessedPaymentEmail {
  id               String   @id @default(cuid())
  messageId        String   @unique
  fromAddress      String?
  subject          String?
  parsedAmount     Float?
  parsedReference  String?
  matchedPaymentId String?
  matchedPayment   Payment? @relation(fields: [matchedPaymentId], references: [id], onDelete: SetNull)
  status           String   @default("PROCESSED")
  createdAt        DateTime @default(now())

  @@index([status, createdAt])
}

model PaymentImportRecord {
  id               String   @id @default(cuid())
  rowKey           String   @unique
  fileName         String?
  amount           Float
  reference        String?
  transactionDate  DateTime?
  matchedPaymentId String?
  status           String
  createdAt        DateTime @default(now())

  @@index([status, createdAt])
}

model GalleryAlbum {
  id             String         @id @default(cuid())
  title          String
  description    String?
  coverImageUrl  String
  category       String
  featured       Boolean        @default(false)
  sortOrder      Int            @default(0)
  /** Optional link to a hosted tournament archive slug (e.g. jvc-mixed-2v2-beach). */
  tournamentSlug String?        @unique
  createdAt      DateTime       @default(now())
  photos         GalleryPhoto[]
}

model GalleryPhoto {
  id        String       @id @default(cuid())
  albumId   String
  album     GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  title     String?
  caption   String?
  imageUrl  String
  /** Smaller grid/list preview; falls back to imageUrl when null. */
  thumbUrl  String?
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
}

model Achievement {
  id          String   @id @default(cuid())
  title       String
  season      String
  description String
  imageUrl    String?
  type        String   @default("TOURNAMENT")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

/** Winner / podium photos for hosted tournament archive pages (keyed by hub slug). */
model TournamentWinnerPhoto {
  id             String   @id @default(cuid())
  tournamentSlug String
  /** PODIUM | FIRST | SECOND | THIRD | OTHER */
  kind           String   @default("OTHER")
  imageUrl       String
  alt            String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([tournamentSlug, sortOrder])
}

/** Cover image for the Our Tournaments overview card (keyed by hub slug). */
model TournamentCover {
  tournamentSlug String   @id
  imageUrl       String
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
}

model ClubTeam {
  id                         String           @id @default(cuid())
  name                       String
  level                      String
  description                String
  details                    String?
  trainingTeamKey            String?          @unique
  syncExcludedClubMemberIds  String           @default("[]")
  sortOrder                  Int              @default(0)
  createdAt                  DateTime         @default(now())
  members                    ClubTeamMember[]
}

model ClubTeamMember {
  id           String      @id @default(cuid())
  teamId       String
  team         ClubTeam    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  clubMemberId String?
  clubMember   ClubMember? @relation(fields: [clubMemberId], references: [id], onDelete: SetNull)
  name         String
  role         String
  position     String?
  isCaptain    Boolean     @default(false)
  hidden       Boolean     @default(false)
  photoUrl     String?
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())

  @@unique([teamId, clubMemberId])
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String
  price       Float
  imageUrl    String?
  category    String
  sizes       String?
  stock       Int         @default(0)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  orderItems  OrderItem[]
}

model Order {
  id        String      @id @default(cuid())
  userId    String
  status    String      @default("PENDING")
  total     Float
  user      User        @relation(fields: [userId], references: [id])
  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Float
  size      String?
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model SiteContent {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model CoachingApplication {
  id                     String    @id @default(cuid())
  fullName               String
  age                    Int
  contactNumber          String
  contactEmail           String
  qualificationLevel     String
  yearsExperience        Int
  canCommuteToBothVenues String
  whyInterested          String
  status                 String    @default("NEW")
  reviewedAt             DateTime?
  reviewedByUserId       String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([status, createdAt])
}

model TrialsApplication {
  id                  String    @id @default(cuid())
  tryingOutFor        String
  fullName            String
  age                 Int
  contactEmail        String
  contactNumber       String
  yearsExperience     Int
  inlDivision         String
  inlDivisionOther    String?
  inlTeamName         String?
  preferredPosition1  String
  preferredPosition2  String
  status              String    @default("NEW")
  reviewedAt          DateTime?
  reviewedByUserId    String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status, createdAt])
}

model ClubOfferAcceptance {
  id                  String   @id @default(cuid())
  teamSlug            String
  fullName            String
  phoneNumber         String   @default("")
  email               String
  preferredKitNumber1 Int?
  preferredKitNumber2 Int?
  commitmentAccepted  Boolean  @default(false)
  signatureDataUrl    String   @default("")
  /// ACCEPTED | DECLINED
  status              String   @default("ACCEPTED")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([teamSlug, createdAt])
  @@index([status, createdAt])
}

model CoachOfferAcceptance {
  id                 String   @id @default(cuid())
  teamSlug           String
  fullName           String
  phoneNumber        String   @default("")
  email              String
  poloMaterial       String   @default("")
  poloSize           String   @default("")
  commitmentAccepted Boolean  @default(false)
  signatureDataUrl   String   @default("")
  /// ACCEPTED | DECLINED
  status             String   @default("ACCEPTED")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([teamSlug, createdAt])
  @@index([status, createdAt])
}

model TrialSession {
  id              String               @id @default(cuid())
  slug            String
  title           String
  description     String?
  startDate       DateTime
  endDate         DateTime?
  location        String?
  locationUrl     String?
  paymentUrl      String?
  reclubUsername  String?
  sessionFee      Float?
  coachName       String?
  active          Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  signups         TrialSessionSignup[]
  paymentProofs   TrialSessionPaymentProof[]

  @@index([slug])
}

model TrialSessionPaymentProof {
  id                 String              @id @default(cuid())
  trialSessionId     String
  trialSession       TrialSession        @relation(fields: [trialSessionId], references: [id], onDelete: Cascade)
  proofScreenshotUrl String
  createdAt          DateTime            @default(now())
  signupId           String?             @unique
  signup             TrialSessionSignup? @relation(fields: [signupId], references: [id], onDelete: SetNull)

  @@index([trialSessionId, createdAt])
}

model TrialSessionSignup {
  id             String                 @id @default(cuid())
  trialSessionId String
  trialSession   TrialSession           @relation(fields: [trialSessionId], references: [id], onDelete: Cascade)
  email          String
  displayName    String
  status         String                 @default("PENDING")
  createdAt      DateTime               @default(now())
  reminders      TrialSessionReminder[]
  paymentProof   TrialSessionPaymentProof?

  @@unique([trialSessionId, email])
  @@index([trialSessionId, createdAt])
  @@index([trialSessionId, status])
}

model TrialSessionReminder {
  id       String             @id @default(cuid())
  signupId String
  signup   TrialSessionSignup @relation(fields: [signupId], references: [id], onDelete: Cascade)
  kind     String
  sentAt   DateTime           @default(now())

  @@unique([signupId, kind])
  @@index([signupId])
}

model KitOrder {
  id                   String   @id @default(cuid())
  firstName            String
  lastName             String
  email                String
  phoneNumber          String   @default("")
  /// men | women
  gender               String
  /// player | libero | both — summary of selected pieces
  kitType              String
  kitSize              String
  playerJersey         Boolean  @default(false)
  playerShorts         Boolean  @default(false)
  liberoJersey         Boolean  @default(false)
  liberoShorts         Boolean  @default(false)
  jerseySize           String   @default("")
  shortsSize           String   @default("")
  preferredKitNumber1  Int
  preferredKitNumber2  Int
  trainingTshirt       Boolean  @default(false)
  trainingTshirtSize   String   @default("")
  trainingTop          Boolean  @default(false)
  trainingTopSize      String   @default("")
  jacketHoodie         Boolean  @default(false)
  jacketHoodieSize     String   @default("")
  jacketHighCollar     Boolean  @default(false)
  jacketHighCollarSize String   @default("")
  jacketFullZip        Boolean  @default(false)
  jacketFullZipSize    String   @default("")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([createdAt])
  @@index([gender, createdAt])
  @@index([kitType, createdAt])
}
