# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/

# pdf generation temp
.tmp/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
/dev.db
/dev.db*
/prisma/dev.db
/prisma/dev.db-journal

/public/uploads/payment-proofs/*
!/public/uploads/payment-proofs/.gitkeep
/public/uploads/gallery/*
!/public/uploads/gallery/.gitkeep
/public/uploads/achievements/*
!/public/uploads/achievements/.gitkeep
