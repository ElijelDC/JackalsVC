{
  "name": "jackals-vc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3005",
    "dev:setup": "node scripts/dev-setup.mjs",
    "dev:prepare": "prisma generate",
    "build": "prisma generate && next build",
    "build:local": "DATABASE_URL=\"file:./prisma/dev.db\" prisma generate && DATABASE_URL=\"file:./prisma/dev.db\" next build",
    "start": "next start",
    "start:local": "DATABASE_URL=\"file:./prisma/dev.db\" next start -p 3000",
    "preview:local": "npm run build:local && npm run start:local",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "generate:sponsor-pdf": "tsx scripts/generate-sponsor-presentation.ts",
    "generate:tournament-rules-pdf": "tsx scripts/generate-tournament-rules.ts",
    "compress:uploads": "tsx scripts/compress-existing-uploads.ts",
    "gallery:thumbs": "tsx scripts/generate-gallery-thumbs.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "date-fns": "4.4.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "heic-convert": "^2.1.0",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "next-auth": "^5.0.0-beta.31",
    "nodemailer": "^7.0.13",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-easy-crop": "^6.2.2",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "playwright": "^1.61.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
